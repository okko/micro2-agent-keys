{
  "name": "micro2-agentkeys",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Show agent session status on a Work Louder Creator Micro 2 via CLI, HTTP API, and VS Code. Up to 20 agent slots, instead of the usual 6.",
  "type": "module",
  "bin": {
    "agentkeys": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/write-build-id.mjs && chmod 755 dist/cli.js",
    "check": "tsc --noEmit",
    "dev:capture:vscode-fixture": "node scripts/capture-vscode-fixture.mjs",
    "dev:capture:vscode-ahp-lifecycle": "npm run build --silent && node scripts/capture-agent-host-question.mjs",
    "dev:mcp-auth-evidence-server": "node scripts/mcp-auth-evidence-server.mjs",
    "dev:mcp-evidence-server": "node scripts/mcp-evidence-server.mjs",
    "predaemon": "npm run build",
    "daemon": "node dist/daemon.js",
    "preprobe": "npm run build",
    "probe": "node dist/research/probe.js",
    "setup": "npm install && scripts/make-app.sh && scripts/install-agent.sh",
    "test": "npm run build --silent && node --test"
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
